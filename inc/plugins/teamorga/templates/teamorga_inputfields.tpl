<tr>
	<td class="thead" colspan="2">Teamorga-Einstellungen</td>
</tr>
<tr>
	<td class="trow2" style="width:30%"><label for="teamorga_deadline">Deadline</label></td>
	<td class="trow2"><input type="date" id="teamorga_deadline" name="teamorga_deadline" value="{$default_deadline}" /></td>
</tr>
<tr>
	<td class="trow1"><label for="teamorga_prio">Priorität</label></td>
	<td class="trow1">
		<select id="teamorga_prio" name="teamorga_prio">
			<option value="low">Niedrig</option>
			<option value="normal" selected="selected">Normal</option>
			<option value="medium">Mittel</option>
			<option value="high">Hoch</option>
			<option value="inactive">Inaktiv</option>
		</select>
	</td>
</tr>
