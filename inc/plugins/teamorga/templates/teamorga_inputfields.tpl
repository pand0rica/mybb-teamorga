<div class="h4w-post-item ganz">
	<div class="teamorga-inputfields">
		<span class="teamorga-inputfields-label">Teamorga-Einstellungen</span>
		<div class="teamorga-form-row">
			<label for="teamorga_deadline">Deadline</label>
			<input type="date" id="teamorga_deadline" name="teamorga_deadline" value="{$default_deadline}" />
		</div>
		<div class="teamorga-form-row">
			<label for="teamorga_prio">Priorität</label>
			<select id="teamorga_prio" name="teamorga_prio">
				<option value="low">Niedrig</option>
				<option value="normal" selected="selected">Normal</option>
				<option value="medium">Mittel</option>
				<option value="high">Hoch</option>
				<option value="inactive">Inaktiv</option>
			</select>
		</div>
	</div>
</div>
<div class="h4w-post-item null"></div>
